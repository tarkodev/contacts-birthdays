<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/homeMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/homeTitle"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/home_events_title"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/homeSearchButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/homeSearchButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_event"
        android:padding="12dp"
        android:src="@drawable/ic_search_24dp"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle"
        app:layout_constraintEnd_toStartOf="@id/homeSortButton"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:tint="?attr/colorOnSurface" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/homeSortButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sort_events"
        android:padding="12dp"
        android:src="@drawable/ic_sort_24dp"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle"
        app:layout_constraintEnd_toStartOf="@id/homeSettingsButton"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:tint="?attr/colorOnSurface" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/homeSettingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/title_settings"
        android:padding="12dp"
        android:src="@drawable/ic_settings_24dp"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:tint="?attr/colorOnSurface" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/homeSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:hint="@string/search_event"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:padding="0dp"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textCursorDrawable="@drawable/custom_cursor"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle"
        app:layout_constraintEnd_toStartOf="@id/homeSearchCloseButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeTitle" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/homeSearchCloseButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_search"
        android:padding="12dp"
        android:src="@drawable/ic_close_24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:tint="?attr/colorOnSurface" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/noEvents"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="3"
        android:paddingHorizontal="48dp"
        android:text="@string/no_events"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="?attr/colorOutline"
        app:drawableTint="?attr/colorOutline"
        app:drawableTopCompat="@drawable/ic_sad_72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/eventRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:scrollbarSize="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>
