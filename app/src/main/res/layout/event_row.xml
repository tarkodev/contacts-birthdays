<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="92dp"
    android:paddingTop="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/eventImage"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/contact_photo"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_birthday_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/roundedImageView"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/eventPerson"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/insert_name_hint"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/eventActions"
        app:layout_constraintStart_toEndOf="@id/eventImage"
        app:layout_constraintTop_toTopOf="@id/eventImage" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/eventDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@id/eventAgeProgression"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/eventImage"
        app:layout_constraintTop_toBottomOf="@id/eventPerson"
        tools:text="27 août 1990" />

    <LinearLayout
        android:id="@+id/eventAgeProgression"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/eventDate"
        app:layout_constraintEnd_toStartOf="@id/eventActions"
        app:layout_constraintStart_toEndOf="@id/eventDate"
        app:layout_constraintTop_toTopOf="@id/eventDate"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/eventAgeCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="· 35" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/eventAgeArrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="4dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_age_arrow_18dp"
            app:tint="?android:attr/textColorSecondary" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/eventAgeNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="36 ans" />

    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/eventCountdown"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/eventActions"
        app:layout_constraintStart_toEndOf="@id/eventImage"
        app:layout_constraintTop_toBottomOf="@id/eventDate"
        tools:text="Aujourd'hui" />

    <LinearLayout
        android:id="@+id/eventActions"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/eventDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/eventNoteAction"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notes"
            android:padding="8dp"
            android:src="@drawable/ic_note_24dp"
            app:tint="?attr/colorOnSurfaceVariant" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/eventZodiacAction"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/zodiac_sign"
            android:padding="8dp"
            android:src="@drawable/ic_zodiac_aries"
            app:tint="?attr/colorPrimary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/eventNotificationAction"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/events_notification_channel"
            android:padding="8dp"
            android:src="@drawable/ic_contact_reminder_off_24dp"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <View
        android:id="@+id/eventDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:alpha="0.35"
        android:background="?attr/colorOutline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
